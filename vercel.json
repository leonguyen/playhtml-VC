{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,

  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*).(js|css|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}